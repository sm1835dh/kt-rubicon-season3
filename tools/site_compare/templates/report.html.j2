<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ product.title }} 국가별 비교</title>
<style>
:root {
  --bg: #f7f7f8; --surface: #ffffff; --surface-2: #f0f1f3; --text: #1b1c1f; --muted: #60636b; --line: #dcdee3;
  --accent: #2f5bd3; --red: #d93036; --red-bg: #fdecec; --amber: #a35a00; --amber-bg: #fff4e0;
  --green: #217a46; --green-bg: #e7f5ec; --purple: #7246b8;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #131417; --surface: #1c1d21; --surface-2: #25272c; --text: #e8e9ec; --muted: #a0a4ad; --line: #34363d;
    --accent: #8aa8ff; --red: #ff6b6f; --red-bg: #3a1a1c; --amber: #ffb547; --amber-bg: #3a2a10;
    --green: #5fd18b; --green-bg: #14301f; --purple: #b495ff;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text);
  font: 14px/1.55 -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Pretendard", "Segoe UI", sans-serif; }
main { max-width: 1480px; margin: 0 auto; padding: 24px 16px 80px; }
h1 { font-size: 24px; margin: 0 0 4px; }
h2 { font-size: 20px; margin: 40px 0 12px; padding-bottom: 6px; border-bottom: 2px solid var(--line); }
h3 { font-size: 16px; margin: 24px 0 8px; }
a { color: var(--accent); }
.muted { color: var(--muted); }
.box { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 14px 16px; }
table { border-collapse: collapse; width: 100%; background: var(--surface); }
th, td { border: 1px solid var(--line); padding: 6px 8px; text-align: left; vertical-align: top; }
thead th { background: var(--surface-2); font-weight: 600; }
.scroll { overflow-x: auto; }
.chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0 0; }
.chip { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface-2); }
.chip.ok { color: var(--green); background: var(--green-bg); border-color: transparent; }
.chip.unavailable, .chip.mismatch, .chip.warn { color: var(--amber); background: var(--amber-bg); border-color: transparent; }
.chip.error { color: var(--red); background: var(--red-bg); border-color: transparent; }
.tag { display: inline-block; font-size: 12px; padding: 1px 8px; border-radius: 10px; border: 1px solid currentColor; margin-right: 4px; }
.tag-국가별 { color: var(--accent); } .tag-사이트 { color: var(--red); } .tag-소스 { color: var(--amber); } .tag-CA-FR { color: var(--purple); }
nav.toc { position: sticky; top: 0; z-index: 5; background: var(--bg); padding: 8px 0; border-bottom: 1px solid var(--line); display: flex; gap: 16px; }
td.cell { white-space: nowrap; }
td.cell a { text-decoration: none; color: var(--text); font-weight: 600; }
td.cell s { display: block; color: var(--muted); font-size: 12px; font-weight: 400; }
td.diff { background: var(--red-bg); } td.diff a { color: var(--red); }
td.st-unavailable, td.st-mismatch, td.st-error { background: var(--amber-bg); }
td.missing { color: var(--muted); }
td.warned { background: var(--amber-bg); }
th.spec-only, td.spec-only { color: var(--muted); background: var(--surface-2); }
table.specs td, table.specs th { font-size: 12px; }
#key-specs td { white-space: normal; min-width: 120px; }
.menu td { text-align: center; } .menu td.no { color: var(--muted); } .menu th[scope=row] { white-space: nowrap; }
.menu tr.raw th { font-style: italic; color: var(--muted); }
.card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px; margin: 0 0 20px; }
.card h3 { margin: 0 0 6px; }
.card-warn { background: var(--amber-bg); color: var(--amber); border-radius: 6px; padding: 6px 10px; margin: 8px 0; font-size: 13px; }
.panels { display: flex; flex-wrap: wrap; gap: 12px; margin: 12px 0; align-items: flex-start; }
.panels figure { flex: 1 1 300px; min-width: 0; max-width: 640px; }
.panels figure.wide { flex-basis: 100%; max-width: 100%; }
figure { margin: 0; }
.plabel { font-weight: 700; font-size: 13px; margin-bottom: 4px; }
.imgwrap { position: relative; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: #fff; }
.imgwrap img { display: block; width: 100%; height: auto; }
.imgwrap.cropped img { max-width: none; transform-origin: 0 0; }
.hl { position: absolute; outline: 3px solid var(--red); outline-offset: 2px; border-radius: 3px; pointer-events: none; }
figcaption { font-size: 12px; color: var(--muted); margin-top: 4px; word-break: break-all; }
.noimg { padding: 30px 10px; text-align: center; color: var(--muted); border: 1px dashed var(--line); border-radius: 6px; }
.obs, .note { white-space: pre-line; margin: 6px 0 0; }
.note { border-left: 3px solid var(--purple); background: var(--surface-2); padding: 8px 12px; border-radius: 0 6px 6px 0; }
.combos { display: grid; grid-template-columns: repeat(auto-fill, minmax(330px, 1fr)); gap: 12px; }
.combo { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 12px; scroll-margin-top: 56px; }
.combo:target { outline: 3px solid var(--accent); }
.combo h4 { margin: 0 0 6px; font-size: 14px; display: flex; justify-content: space-between; gap: 6px; }
.combo table { font-size: 12px; }
.combo th { width: 92px; color: var(--muted); font-weight: 500; }
.thumb { display: block; height: 260px; overflow: hidden; border: 1px solid var(--line); border-radius: 6px; margin: 8px 0; background: #fff; }
.thumb img { width: 100%; }
.warns { color: var(--amber); font-size: 12px; margin: 6px 0 0; padding-left: 18px; }
details summary { cursor: pointer; color: var(--accent); font-size: 13px; margin-top: 6px; }
.shots img { width: 100%; border: 1px solid var(--line); border-radius: 4px; margin-top: 6px; background: #fff; }
.shots .t { font-size: 12px; color: var(--muted); margin-top: 8px; }
</style>
</head>
<body>
<main>
<header>
  <h1>{{ product.title }} 구매 페이지 국가별 비교</h1>
  <div class="muted">캡쳐 {{ run.captured_at }} (KST) · 화면 {{ run.viewport[0] }}×{{ run.viewport[1] }} · 실행 {{ run.run_id }}</div>
  <div class="box" style="margin-top:12px">
    <b>캡쳐 규칙</b>
    <ul style="margin:6px 0 10px; padding-left:18px">
      <li>페이지 로드 후, 옵션 클릭 후 각각 {{ (run.wait_ms / 1000)|round(1) }}초 대기. 가격이 비어 있으면 한 번 더 대기</li>
      <li>쿠키 배너는 거부·필수만 버튼으로 닫음. 트레이드인 Yes·장바구니·로그인은 누르지 않음</li>
      {% if product.mode == "click" %}
      <li>색상은 {{ product.fixed_color }} 고정. 색상별 가격은 {{ product.storages[0] }}에서만 확인</li>
      <li>US 통신사는 {{ product.carriers|join(", ") }}. Verizon 하위 선택은 페이지 기본값</li>
      <li>가격 표의 기준 가격은 선택한 용량의 기기 일시불 가격(추가 옵션 없음)</li>
      {% else %}
      <li>조합: 가격이 달라지는 옵션의 값을 페이지에서 찾아 모두 캡쳐(아래 표의 "조합 축"). 고정 축은 그 값만 선택</li>
      <li>가격 표의 가격은 각 조합의 기기 일시불 가격(추가 옵션 없음). 주요 스펙 표와 카드는 기준 SKU 조합 기준</li>
      {% endif %}
    </ul>
    <div class="scroll"><table>
      <thead><tr><th>구분</th><th>URL</th><th>지역</th>{% if product.mode != "click" %}<th>기준 SKU</th><th>조합 축</th>{% endif %}</tr></thead>
      <tbody>
      {% for c in run.contexts %}
        <tr><td>{{ c.label }}</td><td><a href="{{ c.url }}" target="_blank" rel="noopener">{{ c.url }}</a></td><td>{{ c.region or "—" }}</td>
          {% if product.mode != "click" %}<td>{{ c.ref_sku or "—" }}</td><td>{{ ctx_axes[c.id] }}</td>{% endif %}</tr>
      {% endfor %}
      </tbody>
    </table></div>
    <div class="chips">
      {% for s in ["ok", "unavailable", "mismatch", "error"] %}<span class="chip {{ s }}">{{ s }} {{ status[s] }}</span>{% endfor %}
      <span class="chip warn">경고 있는 조합 {{ n_warned }} (경고 {{ n_warn }}건)</span>
      <span class="chip"><a href="data.json">data.json</a></span>
      <span class="chip"><a href="../../index.html">전체 목차</a></span>
    </div>
    {% if run.discovered %}<div class="muted" style="margin-top:6px">발견한 조합 수: {% for c in run.contexts if c.id in run.discovered %}{{ c.label }} {{ run.discovered[c.id] }}{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
  </div>
</header>

<nav class="toc"><a href="#summary">요약</a><a href="#cards">차이점 카드 ({{ cards|length }})</a><a href="#appendix">부록</a></nav>

<section id="summary">
  <h2>요약</h2>
  <h3>가격 <span class="muted">(기기 일시불 · 칸을 누르면 부록의 해당 조합으로 이동 · 빨간 칸 = 화면 가격 ≠ JSON-LD)</span></h3>
  <div class="scroll"><table id="price-table">
    <thead><tr><th></th>{% for c in cols %}<th{% if c.ctx.spec_only %} class="spec-only"{% endif %}>{{ c.label }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for row in price_rows %}
      <tr><th scope="row">{{ row.label }}</th>
      {% for cell in row.cells %}
        <td class="{{ cell.cls }}" title="{{ cell.title }}">{% if cell.id %}<a href="#combo-{{ cell.id }}">{{ cell.text }}</a>{% else %}{{ cell.text }}{% endif %}{% if cell.was %}<s>{{ cell.was }}</s>{% endif %}{% if cell.status and cell.status != "ok" %}<div class="chip {{ cell.status }}">{{ cell.status }}</div>{% endif %}{% if cell.warn %}<div class="chip warn">경고 {{ cell.warn }}</div>{% endif %}</td>
      {% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table></div>

  {% if key_spec_rows %}
  <h3>주요 스펙 비교 <span class="muted">(컨텍스트별 기준 SKU · 값은 원문 · 칸에 마우스를 올리면 원래 라벨)</span></h3>
  <div class="scroll"><table id="key-specs" class="specs">
    <thead><tr><th></th>{% for c in cols %}<th>{{ c.label }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for row in key_spec_rows %}
      <tr><th scope="row">{{ row.label }}</th>
      {% for cell in row.cells %}{% if cell %}<td title="{{ cell.label }}">{{ cell.value }}</td>{% else %}<td class="no">—</td>{% endif %}{% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% endif %}

  <h3>메뉴(구매 단계) 구성 <span class="muted">({{ product.storages[0] if product.storages else "기준 SKU" }} 기준 · 숫자는 페이지 안 순서)</span></h3>
  <div class="scroll"><table class="menu">
    <thead><tr><th></th>{% for c in cols %}<th>{{ c.label }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for row in menu_rows %}
      <tr{% if row.raw %} class="raw"{% endif %}><th scope="row">{{ row.label }}</th>
      {% for n in row.cells %}{% if n %}<td>✓ {{ n }}</td>{% else %}<td class="no">—</td>{% endif %}{% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table></div>

  <h3>차이점 카드 목차</h3>
  <ol>
  {% for c in cards %}
    <li><a href="#card-{{ c.card.id }}">{{ c.card.title }}</a> {% for t in c.card.tags %}<span class="tag tag-{{ t.split(" ")[0] }}">{{ t }}</span>{% endfor %}{% if c.warnings %} <span class="chip warn">경고 {{ c.warnings|length }}</span>{% endif %}</li>
  {% else %}
    <li class="muted">아직 작성된 카드가 없습니다.</li>
  {% endfor %}
  </ol>
</section>

<section id="cards">
  <h2>차이점 카드</h2>
  {% for c in cards %}
  <article class="card" id="card-{{ c.card.id }}">
    <h3>{{ loop.index }}. {{ c.card.title }}</h3>
    <div>{% for t in c.card.tags %}<span class="tag tag-{{ t.split(" ")[0] }}">{{ t }}</span>{% endfor %}</div>
    {% if c.warnings %}<div class="card-warn">⚠ 이 카드의 참조가 현재 캡쳐와 맞지 않습니다: {{ c.warnings|join(" · ") }}</div>{% endif %}
    <div class="panels">
    {% for p in c.panels %}
      <figure{% if p.wide %} class="wide"{% endif %}>
        <div class="plabel">{{ p.label }} <span class="muted">· {{ p.section }}</span>{% if p.status and p.status != "ok" %} <span class="chip {{ p.status }}">{{ p.status }}</span>{% endif %}{% if p.combo_warnings %} <span class="chip warn" title="{{ p.combo_warnings|join('\n') }}">경고 {{ p.combo_warnings|length }}</span>{% endif %}</div>
        {% if p.img %}
        {% set c = p.crop %}
        <div class="imgwrap{% if c %} cropped{% endif %}" style="{% if p.view_w %}max-width:{{ p.view_w }}px;{% endif %}{% if c %}aspect-ratio:{{ c.x1 - c.x0 }} / {{ c.y1 - c.y0 }}{% endif %}"{% if c %} title="강조 부분만 확대 · 누르면 원본"{% endif %}><a href="{{ p.img }}" target="_blank"><img src="{{ p.img }}" alt="{{ p.label }} {{ p.section }}" loading="lazy"{% if c %} style="width:{{ c.scale }}%;transform:translate(-{{ c.tx }}%,-{{ c.ty }}%)"{% endif %}></a>
          {% for b in p.boxes %}<div class="hl" style="left:{{ b.left }}%;top:{{ b.top }}%;width:{{ b.width }}%;height:{{ b.height }}%"></div>{% endfor %}
        </div>
        {% else %}<div class="noimg">캡쳐 없음</div>{% endif %}
        <figcaption>{% if p.caption %}<b>{{ p.caption }}</b><br>{% endif %}{{ p.got }}{% if p.url %}<br><a href="{{ p.url }}" target="_blank" rel="noopener">{{ p.url }}</a>{% endif %} · <a href="#combo-{{ p.anchor }}">부록</a></figcaption>
      </figure>
    {% endfor %}
    </div>
    <div class="obs"><b>관찰</b>
{{ c.card.observation }}</div>
    <div class="note"><b>정규화·파이프라인 메모</b>
{{ c.card.note }}</div>
  </article>
  {% else %}
  <p class="muted">카드 메모 파일(<code>tools/site_compare/cards/{{ product.id }}.yaml</code>)에 카드를 추가하면 여기에 표시됩니다.</p>
  {% endfor %}
</section>

<section id="appendix">
  <h2>부록</h2>
  {% if checks %}
  <h3>색상별 가격 ({{ product.storages[0] }}{% if product.carriers %}, US는 {{ product.carriers[0] }}{% endif %})</h3>
  <div class="scroll"><table>
    <thead><tr><th></th>{% for col in colors %}<th>{{ col }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for c in run.contexts %}
      <tr><th scope="row">{{ c.label }}</th>
      {% for col in colors %}
        {% set r = (by_ctx[c.id]|selectattr("want.color", "equalto", col)|selectattr("want.storage", "equalto", product.storages[0])|rejectattr("want.carrier", "in", product.carriers[1:])|list|first) %}
        {% if r %}<td class="cell{% if r.status != 'ok' %} st-{{ r.status }}{% endif %}"><a href="#combo-{{ r.combo_id }}">{{ r.got.prices.base if r.got and r.got.prices.base else "—" }}</a><div class="muted" style="font-size:11px">{{ r.got.sku if r.got else "" }}{% if r.status != "ok" %} · {{ r.status }}{% endif %}</div></td>
        {% else %}<td class="no muted">—</td>{% endif %}
      {% endfor %}
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% endif %}

  {% for c in run.contexts %}
  <h3>{{ c.label }}</h3>
  <div class="combos">
  {% for r in by_ctx[c.id] %}
    <article class="combo" id="combo-{{ r.combo_id }}">
      <h4><span>{{ r.combo_id }}</span><span class="chip {{ r.status }}">{{ r.status }}</span></h4>
      <table>
        <tr><th>선택</th><td>{{ r.want.values()|join(" / ") }}{% if r.kind == "color_check" %} <span class="muted">(색상 확인)</span>{% endif %}</td></tr>
        <tr><th>화면 상태</th><td>{% if r.got %}{{ (r.got.selection.values()|list + [r.got.region])|select|join(" | ") }}<br><span class="muted">{{ r.got.sku }}</span>{% else %}—{% endif %}</td></tr>
        <tr><th>기준 가격</th><td>{{ r.got.prices.base if r.got else "—" }}{% if r.price_match is false %} <span class="chip error">JSON-LD 불일치</span>{% elif r.price_match %} <span class="chip ok">JSON-LD 일치</span>{% endif %}</td></tr>
        <tr><th>월 할부</th><td>{{ r.got.prices.monthly if r.got else "" }}</td></tr>
        <tr><th>정가(was)</th><td>{{ r.got.prices.was if r.got else "" }}</td></tr>
        <tr><th>상단 가격</th><td>{{ r.got.prices.headline if r.got else "" }}</td></tr>
        <tr><th>JSON-LD</th><td>{% if r.jsonld %}{{ r.jsonld.price }} {{ r.jsonld.currency }}{% if r.jsonld.strike %} (정가 {{ r.jsonld.strike }}){% endif %}{% else %}—{% endif %}</td></tr>
        <tr><th>URL</th><td style="word-break:break-all">{% if r.url_final %}<a href="{{ r.url_final }}" target="_blank" rel="noopener">{{ r.url_final }}</a>{% endif %}</td></tr>
        <tr><th>캡쳐 시각</th><td>{{ r.captured_at }}</td></tr>
      </table>
      {% if r.warnings %}<ul class="warns">{% for w in r.warnings %}<li>{{ w }}</li>{% endfor %}</ul>{% endif %}
      {% if r.full_shots %}<a class="thumb" href="{{ r.full_shots[0] }}" target="_blank"><img src="{{ r.full_shots[0] }}" alt="{{ r.combo_id }} 전체" loading="lazy"></a>
      <div class="muted" style="font-size:12px">전체 캡쳐: {% for f in r.full_shots %}<a href="{{ f }}" target="_blank">{{ loop.index }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</div>{% endif %}
      {% if r.sections or r.extras %}
      <details><summary>섹션 캡쳐 {{ r.sections|length }}장{% if r.extras %} · 펼친 레이어 {{ r.extras|length }}장{% endif %}</summary>
        <div class="shots">
        {% for s in r.sections %}<div class="t">{{ s.order }}. {{ s.title }}{% if s.section_id %} → {{ sec_labels.get(s.section_id, s.section_id) }}{% endif %}</div><a href="{{ s.path }}" target="_blank"><img src="{{ s.path }}" alt="{{ s.title }}" loading="lazy"></a>{% endfor %}
        {% for s in r.extras %}<div class="t">레이어 {{ s.order }}. {{ s.title }}</div><a href="{{ s.path }}" target="_blank"><img src="{{ s.path }}" alt="{{ s.title }}" loading="lazy"></a>{% endfor %}
        </div>
      </details>
      {% endif %}
      {% if r.specs or r.spec_shots %}
      <details><summary>스펙 {{ r.specs|length }}개{% if r.spec_shots %} · 캡쳐 {{ r.spec_shots|length }}장{% endif %}</summary>
        <table class="specs">
        {% for sp in r.specs %}<tr>{% if loop.first or sp.group != r.specs[loop.index0 - 1].group %}<th>{{ sp.group }}</th>{% else %}<th></th>{% endif %}<td>{{ sp.label }}</td><td>{{ sp.value }}</td></tr>{% endfor %}
        </table>
        <div class="shots">{% for s in r.spec_shots %}<div class="t">{{ s.title }}</div><a href="{{ s.path }}" target="_blank"><img src="{{ s.path }}" alt="{{ s.title }}" loading="lazy"></a>{% endfor %}</div>
      </details>
      {% endif %}
    </article>
  {% endfor %}
  </div>
  {% endfor %}
</section>
</main>
</body>
</html>
